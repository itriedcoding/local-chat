{
  "name": "local-chat",
  "version": "2.1.0",
  "description": "Local, private desktop AI chat with a built-in code editor for any language",
  "author": "Local Chat",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win --x64",
    "icon": "node build/gen-icon.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "codemirror": "^5.65.21",
    "node-llama-cpp": "^3.8.1"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.localchat.desktop",
    "productName": "Local Chat",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/*.dll"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Local Chat",
      "artifactName": "Local-Chat-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Local-Chat-Portable-${version}.exe"
    }
  }
}
